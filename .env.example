PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=university_inventory
PGUSER=inventory_app
PGPASSWORD=replace_with_your_database_password

# Generate privately; see docs/AUTHENTICATION.md. Never commit the real value.
SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
NODE_ENV=development
PORT=8080
# Optional in local development. Required HTTPS origin in production.
# APP_ORIGIN=https://inventory.example.edu
# Set to 1 only behind the same-host HTTPS reverse proxy.
TRUST_PROXY=0
